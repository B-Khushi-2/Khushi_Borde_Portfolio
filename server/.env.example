# Copy this file to .env for local development: cp .env.example .env
# On a host like Render/Railway, set these under the project's
# Environment Variables settings instead of using a .env file.

# ---- Server -----------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call this API from a browser.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- LLM provider (Gemini/OpenAI abstraction) --------------------------
# Which provider /api/chat uses by default. A request can override this
# per-call with { "provider": "gemini" } in the body.
#
# Leave this as "mock" to run with ZERO setup: no API key, no network call,
# no cost. The built-in mock provider answers directly from whatever the
# RAG step retrieves from the knowledge base — real retrieval, just no LLM
# writing the prose. Set to "openai" or "gemini" + fill in the matching key
# below for actual AI-generated answers.
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only change this if routing through a proxy/Azure OpenAI-compatible gateway.
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ---- RAG: embeddings + knowledge base -----------------------------------
# Which provider embeds the knowledge base and incoming questions.
#
# Leave this as "local" to run with ZERO setup: no API key, no network
# call, dependency-free hashing-trick vectors — good enough for a
# portfolio-sized knowledge base. Set to "openai" or "gemini" (reusing the
# API keys above, no separate key needed) for stronger semantic retrieval —
# just re-run `npm run kb:build` after switching, since the index has to be
# built with whichever provider will query it.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Chunking (characters, not tokens — see server/rag/chunker.js)
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# Retrieval
RAG_TOP_K=4
# Cosine-similarity floor (0-1). Chunks scoring below this are dropped
# before they ever reach the model — raise it to be stricter about what
# counts as "relevant enough to answer from".
RAG_MIN_SCORE=0.08

LLM_TEMPERATURE=0.6
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_MS=400
# Hard ceiling (ms) on how long one reply may take, thinking + streaming.
LLM_STREAM_TIMEOUT_MS=30000

# ---- Request validation -------------------------------------------------
CHAT_MAX_MESSAGES=30
CHAT_MAX_MESSAGE_CHARS=50000

# ---- Rate limiting --------------------------------------------------------
CHAT_RATE_LIMIT_WINDOW_MS=300000
CHAT_RATE_LIMIT_MAX=20
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=100
CONTACT_RATE_LIMIT_WINDOW_MS=600000
CONTACT_RATE_LIMIT_MAX=5

# ---- Contact form (existing feature — Gmail example) --------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-character-app-password
CONTACT_TO=your.email@gmail.com
