# Copy this file to .env for local testing with server.js.
# On Vercel, set these same keys under Project Settings -> Environment Variables
# instead of using a .env file.

# ---- Gmail example (see README.md for the app-password steps) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-character-app-password

# Where the message actually lands. Defaults to SMTP_USER if omitted.
CONTACT_TO=your.email@gmail.com
